#!/bin/bash
# Setup script for dbus-bms-switcher

packageLogName="dbus-bms-switcher"
SERVICE_NAME="dbus-bms-switcher"
SCRIPT_DIR=$(cd $(dirname $0) && pwd)
GUI_DIR="/opt/victronenergy/gui/qml"

# Import SetupHelper function library
if [ -f /data/SetupHelper/HelperResources/IncludeHelpers ]; then
    source /data/SetupHelper/HelperResources/IncludeHelpers
else
    echo "ERROR: SetupHelper is required to run this setup script."
    exit 1
fi

# --- INSTALL ACTION ---
if [ $scriptAction == "INSTALL" ]; then
    logMessage "Installing $packageLogName..."

    # 1. Install D-Bus Python Service
    mkdir -p /data/$packageLogName
    cp -f $SCRIPT_DIR/dbus-bms-switcher.py /data/$packageLogName/
    chmod +x /data/$packageLogName/dbus-bms-switcher.py
    installService $SERVICE_NAME

    # 2. Copy QML GUI Overlay Files
    if [ -d "$SCRIPT_DIR/qml" ]; then
        logMessage "Installing QML GUI overlay files..."
        cp -rf $SCRIPT_DIR/qml/* $GUI_DIR/
        restartGui=true
    fi

    logMessage "Completed installation of $packageLogName"
fi

# --- UNINSTALL ACTION ---
if [ $scriptAction == "UNINSTALL" ]; then
    logMessage "Uninstalling $packageLogName..."

    # 1. Remove D-Bus Service
    removeService $SERVICE_NAME
    rm -rf /data/$packageLogName

    # 2. Remove Custom QML Files
    if [ -d "$SCRIPT_DIR/qml" ]; then
        logMessage "Removing QML GUI overlay files..."
        find "$SCRIPT_DIR/qml" -type f -exec basename {} \; | while read -r filename; do
            rm -f "$GUI_DIR/$filename"
        done
        restartGui=true
    fi

    logMessage "Completed uninstallation of $packageLogName"
fi

endScript
